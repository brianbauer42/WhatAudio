{
  "name": "what-audio",
  "version": "1.0.0",
  "private": true,
  "description": "An infinite playlist music platform",
  "type": "module",
  "license": "ISC",
  "author": "Brian Bauer",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "rimraf static server-built",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:server": "tsc",
    "build:client": "vite build",
    "build": "pnpm run clean && pnpm run build:server && pnpm run build:client",
    "start": "node server-built/server.js",
    "prod": "pnpm run build && pnpm start",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite --host",
    "seed": "tsx server/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "axios": "^1.14.1",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "~26.4.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianbauer42/InfinitePlaylist.git"
  },
  "bugs": {
    "url": "https://github.com/brianbauer42/InfinitePlaylist/issues"
  },
  "homepage": "https://github.com/brianbauer42/InfinitePlaylist#readme",
  "packageManager": "pnpm@12.3.4"
}
