# Copy this file to .env and fill in the values before starting the server.

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where MongoDB lives.
MONGO_URI=mongodb://127.0.0.1:27017/WhatAudio

# Port the API/server listens on. The dev client server runs on 3000 and
# proxies /api and /resources here.
PORT=8080
HOST=localhost

# Shown on the /contact page.
CONTACT_EMAIL=you@example.com

# Where uploaded audio and album art are written.
UPLOAD_DIR=./uploads

# Session cookies are marked HTTPS-only when NODE_ENV=production. Set this to
# false if you serve the app over plain HTTP (logins will not stick otherwise).
# COOKIE_SECURE=true

# Whether anyone may create an account. Defaults to true in development and
# false when NODE_ENV=production.
# ALLOW_REGISTRATIONS=true

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_MB=100
