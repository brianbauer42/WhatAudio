# Copy this file to .env and fill in the values before starting the server.
# Every value has a working default for local development against the
# services in compose.yaml; only SESSION_SECRET needs attention.

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production.
SESSION_SECRET=

# Postgres connection string. Required when NODE_ENV=production.
DATABASE_URL=postgres://whataudio:whataudio@127.0.0.1:5432/whataudio

# S3-compatible object storage for uploaded audio and art. Garage locally;
# Garage, Cloudflare R2, Backblaze B2, etc. in production. The endpoint must be
# reachable from browsers, because media links are presigned URLs on it.
# Access and secret keys are required when NODE_ENV=production.
S3_ENDPOINT=http://localhost:3900
# Only needed when browsers reach the store at a different URL than the server
# does (compose.yaml sets it for the app container). Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=garage
S3_BUCKET=whataudio
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Origins allowed to load media directly from the bucket (comma-separated).
# Set this to your site's origin in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Port the API/server listens on. The dev client server runs on 3000 and
# proxies /api here.
PORT=8080
HOST=localhost

# Shown on the /contact page.
CONTACT_EMAIL=you@example.com

# Session cookies are marked HTTPS-only when NODE_ENV=production. Set this to
# false if you serve the app over plain HTTP (logins will not stick otherwise).
# COOKIE_SECURE=true

# Whether anyone may create an account. Defaults to true in development and
# false when NODE_ENV=production.
# ALLOW_REGISTRATIONS=true

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_MB=100
